#!/usr/bin/env python3
"""Check required project files, Markdown links, and instruction structure."""

from __future__ import annotations

import re
import sys
from pathlib import Path

from instruction_utils import OUTPUT, RULES, build_content

ROOT = Path(__file__).resolve().parent.parent
MAX_BYTES = 32 * 1024
REQUIRED = (
    "README.md", "AGENTS.md", ".gitignore", "config/config.example.toml",
    "docs/architecture.md", "docs/changelog.md", "templates/project-AGENTS.md",
    "templates/delegation-brief.md", "scripts/build-instructions", "scripts/install",
    "scripts/validate", "tests/test_tools.py",
)
LINK_RE = re.compile(r"(?<!!)\[[^\]]*\]\(([^)]+)\)")


def main() -> int:
    failures: list[str] = []
    for name in REQUIRED:
        if not (ROOT / name).is_file():
            failures.append(f"missing required file: {name}")
    for name in RULES:
        if not (ROOT / "rules" / name).is_file():
            failures.append(f"missing rule source: rules/{name}")

    for path in ROOT.rglob("*.md"):
        if any(part in {".git", ".agents", ".codex", ".aws", "build", "__pycache__"} for part in path.parts):
            continue
        text = path.read_text(encoding="utf-8")
        if "<<<<<<< " in text or "=======" in text or ">>>>>>> " in text:
            failures.append(f"conflict marker in {path.relative_to(ROOT)}")
        for destination in LINK_RE.findall(text):
            destination = destination.strip()
            if not destination or destination.startswith(("http://", "https://", "mailto:", "#")):
                continue
            local = destination.split("#", 1)[0].split("?", 1)[0]
            if local and not (path.parent / local).exists():
                failures.append(f"broken relative link in {path.relative_to(ROOT)}: {destination}")
        if not text.startswith("# "):
            failures.append(f"document should start with a level-one heading: {path.relative_to(ROOT)}")

    content = build_content()
    if len(content) >= MAX_BYTES:
        failures.append(f"generated instruction file is {len(content)} bytes; limit is under {MAX_BYTES}")
    decoded = content.decode("utf-8")
    for section in ("Scope and persistence", "Engineering", "Communication", "Permissions and sensitive data", "Orchestration and delegation"):
        if section not in decoded:
            failures.append(f"generated instructions missing expected section: {section}")
    if failures:
        for failure in failures:
            print(f"FAIL: {failure}", file=sys.stderr)
        return 1
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_bytes(content)
    print(f"Validation passed: required files, Markdown links and structure; generated instructions {len(content)} bytes (< {MAX_BYTES}).")
    print("This is a basic structural check, not a Markdown parser or a semantic conflict analysis.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, UnicodeError) as error:
        print(f"validate: {error}", file=sys.stderr)
        raise SystemExit(1)
